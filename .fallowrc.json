{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.turbo/**",
    "**/coverage/**",
    "**/__tests__/**",
    "packages/create-app/bin/*.js",
    "packages/generators/test/**",
    "apps/playground/cms/collections/posts.ts",
    "packages/create-app/explicit/cms/collections/posts.ts",
    "packages/create-app/my-cms/cms/collections/posts.ts",
    "packages/create-app/my-value/cms/collections/posts.ts",
    "**/__generated__/**"
  ],
  "ignoreDependencies": [
    "@blazing-cms/types",
    "@blazing-cms/core",
    "@blazing-cms/schema",
    "@blazing-cms/validation",
    "@blazing-cms/cms",
    "clsx",
    "lucide-react",
    "react",
    "tailwind-merge",
    "@tailwindcss/vite",
    "@tanstack/react-query",
    "dompurify",
    "@types/dompurify",
    "marked",
    "@types/marked"
  ],
  "audit": {
    "gate": "new-only"
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 30,
    "maxUnitSize": 150,
    "maxCrap": 30,
    "ignore": ["packages/*/test/**/*.test.ts", "apps/*/test/**/*.test.ts"],
    "thresholdOverrides": [
      {
        "files": ["packages/cms/src/admin/vite-plugins/schema-writer.ts"],
        "maxCrap": 60,
        "reason": "Vite plugin with HTTP body parsing and validation — untested new file"
      },
      {
        "files": ["packages/cms/src/index.ts"],
        "maxUnitSize": 250,
        "maxCyclomatic": 70,
        "maxCognitive": 110,
        "maxCrap": 650,
        "reason": "command-line arg parser with multiple subcommands including generate:types/sdk/validation"
      },
      {
        "files": ["packages/cms/src/commands/promote.ts"],
        "maxCrap": 80,
        "reason": "CLI command with env resolution, admin SDK init, user lookup, and claim promotion"
      },
      {
        "files": ["packages/validation/src/generator.ts"],
        "maxCyclomatic": 45,
        "maxCognitive": 30,
        "maxCrap": 310,
        "reason": "field-to-Zod mapping with regex validation for each field type"
      },
      {
        "files": ["packages/generators/src/sdk.ts"],
        "maxCrap": 300,
        "maxCyclomatic": 20,
        "maxCognitive": 20,
        "reason": "field-to-TS-type mapping with many type branches"
      },
      {
        "files": ["packages/cms/src/admin/components/field-input.tsx"],
        "maxCrap": 115,
        "reason": "per-field-type input renderer with required indicator and RBAC read/write gates"
      },
      {
        "files": ["packages/schema/src/loader.ts"],
        "maxCrap": 60,
        "reason": "SchemaLoader with ESM dynamic imports — both cached and fresh variants"
      },
      {
        "files": ["packages/cms/src/admin/components/sidebar.tsx"],
        "maxCrap": 320,
        "reason": "nav section builder filtering collections and system links by RBAC grants and capability flags"
      },
      {
        "files": ["packages/cms/src/admin/routes/collections/$slug.tsx"],
        "maxCrap": 95,
        "reason": "entry list with fallback title resolution, status badges, and create gate"
      },
      {
        "files": ["packages/cms/src/admin/routes/collections/$slug.$id.revisions.tsx"],
        "maxCrap": 35,
        "reason": "revisions route with RBAC read gate and versioning capability gate"
      },
      {
        "files": ["packages/cms/src/admin/routes/collections/new.$slug.tsx"],
        "maxCrap": 35,
        "reason": "entry form with RBAC create gate and back navigation"
      },
      {
        "files": ["packages/cms/src/admin/routes/collections/$slug.$id.edit.tsx"],
        "maxCrap": 60,
        "reason": "entry editor with RBAC update gate, capability-gated workflow/versioning panels, and delete flow"
      },
      {
        "files": ["packages/cms/src/admin/routes/users/index.tsx"],
        "maxCrap": 35,
        "reason": "user list with role badges from user_roles join and manage gate"
      },
      {
        "files": ["packages/cms/src/admin/routes/users/new.tsx"],
        "maxCrap": 60,
        "reason": "user form with role checkbox list and RBAC save gate"
      },
      {
        "files": ["packages/cms/src/admin/routes/users/$id.tsx"],
        "maxCrap": 60,
        "reason": "user detail with role assignment editor and delete flow"
      },
      {
        "files": ["packages/cms/src/admin/routes/roles/index.tsx"],
        "maxCrap": 35,
        "reason": "role list with grant summary chips and manage gate"
      },
      {
        "files": ["packages/cms/src/admin/routes/media/$id.tsx"],
        "maxCrap": 45,
        "reason": "media detail route with replace/delete/usage actions gated by manageMedia"
      },
      {
        "files": ["packages/cms/src/admin/components/notification-bell.tsx"],
        "maxCrap": 60,
        "reason": "notification dropdown with unread badge, mark-read flow, and entry navigation"
      },
      {
        "files": ["packages/cms/src/admin/components/workflow-panel.tsx"],
        "maxCrap": 60,
        "reason": "workflow state panel with reviewer assignment, comment entry, transitions, and history timeline"
      },
      {
        "files": ["packages/cms/src/admin/lib/providers/firebase.ts"],
        "maxCrap": 100,
        "reason": "workflow transition and notification helpers, RBAC-aware provider methods, and batched importContent write path"
      },
      {
        "files": ["packages/cms/src/admin/lib/import-export/validate.ts"],
        "maxCyclomatic": 25,
        "maxCognitive": 30,
        "maxCrap": 50,
        "reason": "per-field-type validation with constraint checks for each scalar input type"
      },
      {
        "files": ["packages/cms/src/admin/routes/settings/content.tsx"],
        "maxCrap": 120,
        "reason": "ContentTools component handling full export, file import, and progress/result UI with TanStack Query invalidation"
      },
      {
        "files": ["packages/sdk/src/workflow.ts"],
        "maxCrap": 35,
        "reason": "workflow transition API with existence guard, optional reviewer notification, and patch composition"
      },
      {
        "files": ["packages/schema/src/validator.ts"],
        "maxCrap": 140,
        "reason": "capability config validation (validateCapabilities, collection/global feature validators) plus field validation"
      },
      {
        "files": ["packages/sdk/src/client.ts"],
        "maxCrap": 140,
        "reason": "createBlazeClient with per-capability disabled stubs and write gating"
      },
      {
        "files": ["packages/cms/src/commands/generate.ts"],
        "maxCrap": 100,
        "reason": "rules generation gated on resolved capability flags (content, per-collection workflow/versioning, rbac, media, notifications)"
      },
      {
        "files": ["packages/cms/src/commands/load-config.ts"],
        "maxCrap": 80,
        "reason": "jiti-based project config loader with graceful fallback and cwd resolution"
      },
      {
        "files": ["packages/cms/src/admin/components/app-layout.tsx"],
        "maxCrap": 50,
        "reason": "route guard with auth claim check, admin enforcement toast, and loading state"
      },
      {
        "files": ["packages/cms/src/admin/routes/login.tsx"],
        "maxCrap": 35,
        "reason": "login form with email/password and Google sign-in plus post-login admin claim enforcement"
      }
    ]
  },
  "duplicates": {
    "mode": "mild",
    "minTokens": 50,
    "skipLocal": true,
    "threshold": 5.0,
    "ignore": [
      "packages/cms/src/commands/scaffold.ts",
      "packages/cms/src/admin/routes/schemas/new.tsx",
      "packages/cms/src/admin/routes/users/$id.tsx",
      "packages/cms/src/admin/routes/globals/$slug.tsx",
      "packages/cms/src/admin/lib/providers/firebase.ts",
      "packages/cms/src/admin/lib/providers/analytics-helpers.ts",
      "packages/cms/src/admin/lib/media/validation.ts",
      "packages/cms/src/admin/lib/media/usage.ts",
      "packages/sdk/src/types.ts",
      "packages/sdk/src/collection.ts",
      "packages/sdk/src/analytics.ts",
      "packages/sdk/src/media.ts"
    ]
  },
  "entry": ["packages/*/src/index.ts", "scripts/serve-spa.mjs"]
}
