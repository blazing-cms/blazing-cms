{
  "name": "@blazing-cms/sdk",
  "version": "0.1.4",
  "description": "Browser SDK for Blazing CMS — wraps Firebase client SDK for typed content consumption",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "firebase": "^12.16.0"
  },
  "devDependencies": {
    "firebase": "^12.16.0"
  },
  "dependencies": {
    "@blazing-cms/types": "workspace:*"
  }
}
