{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "exclude": ["files", "duplicates"],
  "ignoreDependencies": ["@blazing-cms/*", "zod"],
  "ignoreFiles": [
    "**/test/**",
    "**/__generated__/**",
    "**/dist/**",
    "packages/create-app/explicit/**",
    "packages/create-app/my-cms/**",
    "packages/create-app/my-value/**"
  ],
  "ignoreIssues": {
    "packages/core/src/container.ts": ["exports", "types"],
    "packages/core/src/event-bus.ts": ["exports", "types"],
    "packages/core/src/lifecycle.ts": ["exports", "types"],

    "packages/schema/src/watcher.ts": ["exports", "types"],
    "packages/sdk/src/client.ts": ["exports", "types"],
    "packages/types/src/schema.ts": ["types"],

    "packages/cms/src/admin/__generated__/schema-registry.ts": ["exports"],

    "packages/cms/src/admin/lib/import-export/types.ts": ["exports", "types"],
    "packages/cms/src/admin/lib/providers/types.ts": ["types"]
  }
}
